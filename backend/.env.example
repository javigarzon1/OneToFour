# Cadena de conexión de Neon. Usa la URL con "pooler" (host ...-pooler...) y sslmode=require.
DATABASE_URL=postgresql://usuario:contrasena@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

GROQ_API_KEY=pon_aqui_la_api_key
GROQ_MODEL=qwen/qwen3.8-27b
CORS_ORIGINS=http://localhost:5173

# Límite de uso del agente IA (opcionales; estos son los valores por defecto).
# AGENT_RATE_LIMIT=5              # generaciones por IP y ventana
# AGENT_RATE_WINDOW_SECONDS=600   # duración de la ventana
# AGENT_DAILY_LIMIT=300           # tope diario total
# RATE_LIMIT_SALT=cambia-esto     # sal para anonimizar las IP
